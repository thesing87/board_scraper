<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 휴대폰을 껐다 켜도 못 보낸 알림을 다시 보내도록 (JobScheduler 작업 유지) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- '배터리 사용 제한 없음' 요청 창을 띄우기 위해 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 새 버전 자동 업데이트 (가계부에 올라간 앱을 받아 설치) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 금액 인식 알림 (안드로이드 13 이상은 사용자가 허용해야 함) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 집 NAS를 http 주소로 쓰는 경우가 있어 평문 연결도 허용 -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 설정: 가계부 주소·권한·연결 주소·앱별 끄기·최근 보낸 알림 -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="YeYe홈 설정"
            android:parentActivityName=".MainActivity" />

        <!-- 알림 읽기: 설정 > 알림 읽기 권한에서 켜야 동작 -->
        <service
            android:name=".NotifyListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- 홈 화면 근무표 위젯 (한 달·오늘). 처음 놓을 때 누구 근무표인지 고르는 화면 -->
        <receiver
            android:name=".DutyMonthWidget"
            android:label="@string/duty_widget_month"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/duty_widget_month" />
        </receiver>
        <receiver
            android:name=".DutyTodayWidget"
            android:label="@string/duty_widget_today"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/duty_widget_today" />
        </receiver>
        <activity
            android:name=".DutyWidgetConfig"
            android:exported="true"
            android:label="근무표 위젯"
            android:theme="@android:style/Theme.Material.Light.Dialog.NoActionBar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- 업데이트 설치 결과 (확인 창 띄우기) -->
        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />

        <!-- 인터넷이 끊겨 못 보낸 알림을 연결되면 다시 보냄 -->
        <service
            android:name=".RetryJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
