<?xml version="1.0" encoding="utf-8"?>
<!-- 한 달 근무표 위젯: DutyWidgets가 위젯 크기만 한 그림을 그려 넣고, 맨 위에 누를 자리를 투명하게 겹침 (1.24부터 달 넘기기).
     자리는 그림의 맨 위와 같은 dp: 여백 10 · 화살표 24 · 사이 4 · 제목 (같은 글자를 투명하게 넣어 폭을 맞춤) · 사이 4 · 화살표 24 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/duty_widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="근무표" />

    <!-- 날짜 칸마다 누를 자리 (1.25부터 누르면 앱에서 그 날짜): 그림의 달력 자리와 같게 위 56 (여백 10 + 맨 위 28 + 요일 18) · 양옆 10 · 아래 8dp,
         주 수(4~6)만큼 줄을 보이고 나머지는 숨김 -->
    <LinearLayout
        android:id="@+id/duty_days"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/duty_r0"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <FrameLayout android:id="@+id/duty_d0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/duty_d1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/duty_d2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/duty_d3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/duty_d4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/duty_d5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/duty_d6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/duty_r1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <FrameLayout android:id="@+id/duty_d7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/duty_d8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/duty_d9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/duty_d10" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/duty_d11" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/duty_d12" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/duty_d13" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/duty_r2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <FrameLayout android:id="@+id/duty_d14" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/duty_d15" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/duty_d16" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/duty_d17" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/duty_d18" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/duty_d19" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/duty_d20" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/duty_r3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <FrameLayout android:id="@+id/duty_d21" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/duty_d22" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/duty_d23" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/duty_d24" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/duty_d25" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/duty_d26" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/duty_d27" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/duty_r4"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <FrameLayout android:id="@+id/duty_d28" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/duty_d29" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/duty_d30" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/duty_d31" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/duty_d32" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/duty_d33" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/duty_d34" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/duty_r5"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <FrameLayout android:id="@+id/duty_d35" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/duty_d36" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/duty_d37" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/duty_d38" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/duty_d39" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/duty_d40" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
            <FrameLayout android:id="@+id/duty_d41" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/duty_nav"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:visibility="gone">
        <FrameLayout
            android:id="@+id/duty_nav_prev"
            android:layout_width="38dp"
            android:layout_height="match_parent"
            android:contentDescription="지난달" />
        <TextView
            android:id="@+id/duty_nav_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#00000000"
            android:textSize="16dp"
            android:textStyle="bold" />
        <FrameLayout
            android:id="@+id/duty_nav_next"
            android:layout_width="38dp"
            android:layout_height="match_parent"
            android:contentDescription="다음 달" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/duty_nav_back"
        android:layout_width="90dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:contentDescription="이번 달로"
        android:visibility="gone" />
</FrameLayout>
